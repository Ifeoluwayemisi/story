# Frontend environment — copy to `.env.local` (never commit real values).
# Full contract: docs/environment.md
# Public configuration ONLY. Never put a secret (e.g. the Brevo API key) here,
# and never behind NEXT_PUBLIC_.

# Base URL of the backend contact endpoint (public configuration — not a secret).
# Consumed by the contact form (Phase 8). Production: set to the deployed
# backend URL at build time (NEXT_PUBLIC_ values are inlined into the bundle).
NEXT_PUBLIC_CONTACT_API_URL=http://localhost:3001