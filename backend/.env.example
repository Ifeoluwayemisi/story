# Backend environment — copy to `.env` (never commit real values).
# Full contract: docs/environment.md
# RESEND_API_KEY is a SECRET — backend only, never the frontend, never committed.

# The HTTP port the server listens on (optional; defaults to 3001).
PORT=3001

# Resend (ADR-004) — provider API key. SECRET. Omitting it disables contact
# delivery (the backend fails closed).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Sender address — must be on a verified Resend sending domain in production
# (the Resend sandbox sender works for local testing).
CONTACT_FROM_EMAIL=hello@example.com

# Sender display name.
CONTACT_FROM_NAME=Your Name

# Delivery target — Racheal's inbox. Real value comes from Racheal (Phase 0).
CONTACT_TO_EMAIL=you@example.com