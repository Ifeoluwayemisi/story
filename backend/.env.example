# Backend environment — copy to `.env` (never commit real values).
# Full contract: docs/environment.md
# BREVO_API_KEY is a SECRET — backend only, never the frontend, never committed.

# The HTTP port the server listens on (optional; defaults to 3001).
PORT=3001

# Brevo (ADR-004) — provider API key. SECRET. Omitting it disables contact
# delivery (the backend fails closed).
BREVO_API_KEY=xkeysib-xxxxxxxxxxxx

# Sender address — must be a verified Brevo sender in production
# (the Brevo sandbox sender works for local testing).
CONTACT_FROM_EMAIL=hello@example.com

# Sender display name.
CONTACT_FROM_NAME=Your Name

# Delivery target — Racheal's inbox. Real value comes from Racheal (Phase 0).
CONTACT_TO_EMAIL=you@example.com