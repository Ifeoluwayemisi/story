# Backend environment — copy to `.env` (never commit real values).
# Full contract: docs/environment.md
# BREVO_API_KEY is a SECRET — backend only, never the frontend, never committed.

# The HTTP port the server listens on (optional; defaults to 5010).
PORT=5010

# CORS allow-list for the contact endpoint (comma-separated, public config).
# The browser blocks cross-origin form posts without these. Defaults to the
# localhost dev origins; production must set the real frontend origin(s).
# CORS_ALLOWED_ORIGINS=https://portfolio.example.com

# Brevo (ADR-004) — provider API key. SECRET. Omitting it disables contact
# delivery (the backend fails closed).
# BREVO_API_KEY=
# Sender address — must be a verified Brevo sender in production
# (the Brevo sandbox sender works for local testing).
CONTACT_FROM_EMAIL=destinifeoluwa@gmail.com

# Sender display name.
CONTACT_FROM_NAME=Olayode Racheal

# Delivery target — Racheal's inbox. Real value comes from Racheal (Phase 0).
CONTACT_TO_EMAIL=destinifeoluwa@gmail.com